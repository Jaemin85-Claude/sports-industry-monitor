 {
  "t": "grep",
  "memo": "on.ae 공개 상품 사이트맵(robots.txt Sitemap → /sitemap.xml 색인 → 기본 언어 sitemap_products_1 — /ar/는 kid_pref로 뺌, 요청 2번)에서 대상 모델 handle 확인. 11/03 사이트맵에 cloud-6-coast·cloudsurfer-next·cloudsurfer-max·cloud-6·cloudmonster-3·cloudrunner-3·cloudmonster-1 있었음 · cloudzone은 products.json 2쪽 · cloudrock·cloudultra·cloudboom·cloudmonster-1-waterproof는 처음 찾음(11/11 시험에서 클라우드몬스터 1 WP는 on.ae 404)",
  "sites": {
   "onae": {
    "host": "on.ae",
    "start": [
     "https://on.ae/sitemap.xml"
    ],
    "kid_pref": [
     "on.ae/sitemap_products"
    ],
    "sample": 2
   }
  },
  "rx": "^https://on\\.ae/products/(cloudmonster-1|cloudrock|cloudultra|cloudboom|cloudzone|cloud-6|cloudsurfer-next|cloudsurfer-max|cloudmonster-3|cloudrunner-3)",
  "max_maps": 2,
  "per_host": 90,
  "show": 60
 },
